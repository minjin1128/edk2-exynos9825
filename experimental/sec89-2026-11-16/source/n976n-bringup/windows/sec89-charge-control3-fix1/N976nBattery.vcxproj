<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{DFF0E788-BC7A-4B3A-BB80-883BA7000088}</ProjectGuid>
    <ProjectName>N976nBattery</ProjectName>
    <TargetName>N976nBattery</TargetName>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>15</KMDF_VERSION_MINOR>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <WppEnabled>false</WppEnabled>
      <ForcedIncludeFiles>$(ProjectDir)KernelTypes.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalIncludeDirectories>$(ProjectDir)kernel-portable;$(ProjectDir)common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <Optimization>MinSpace</Optimization>
      <AdditionalOptions>%(AdditionalOptions) /Brepro /arch:armv8.0 /forceInterlockedFunctions-</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>Battc.lib;Wmilib.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <AdditionalOptions>/Brepro /VERBOSE:LIB %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="Device.c" /><ClCompile Include="AdcWdf.c" /><ClCompile Include="common\Adc.c" /><ClCompile Include="Charge.c" /><ClCompile Include="PowerSource.c" /><ClCompile Include="Bench.c" /><ClCompile Include="ThermalBridge.c" /><ClCompile Include="common\Thermal.c" /><ClCompile Include="common\ChargeControl.c" /><ClCompile Include="ClockShare.c" /><ClCompile Include="Bus.c" /><ClCompile Include="Backend.c" /><ClCompile Include="Lease.c" /><ClCompile Include="BatteryCache.c" /><ClCompile Include="Miniclass.c" /><ClCompile Include="common\N976nBattery.c" /><FilesToPackage Include="$(TargetPath)" /></ItemGroup>
  <Target Name="ValidateOfflineBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'ARM64'" Text="SEC88 battery is an ARM64-only development target." />
    <Error Condition="'$(SignMode)' != 'Off'" Text="Use the separately reviewed device signing/deployment workflow." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
